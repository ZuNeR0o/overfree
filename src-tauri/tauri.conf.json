{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.1.3",
  "identifier": "app.folio.editor",
  "build": {
    "frontendDist": "../shell",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3QkUxOTM3NDAwQ0NCMDAKUldRQXl3eEFOeG0raDE1dEt1TkI4RTl1QUJJWFIzOUpwRlNjdmwvWWtBekRqZ2k1MEhXOW9wVUYK",
      "endpoints": ["https://github.com/GITHUB_USER/overfree/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../dist/": "web/"
    },
    "shortDescription": "Editor LaTeX local",
    "longDescription": "Editor LaTeX que compila en tu equipo, sin conexión y sin límites de tiempo.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    }
  }
}
